<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#B0C4DE"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/personalDataGroupBoxLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp">
        <GridLayout
            android:id="@+id/personalDataInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:background="@drawable/white_border"
            android:padding="20dp"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="15dp"
            android:rowCount="3">
            <TextView
                android:id="@+id/nameLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_column="0"
                android:layout_row="0"
                android:layout_columnWeight="2"
                android:labelFor="@id/nameInput"
                android:text="@string/imie"/>

            <EditText
                android:id="@+id/nameInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_row="0"
                android:layout_column="1"
                android:importantForAutofill="no"
                android:ems="0"
                android:minWidth="0dp"
                android:inputType="text"
                android:layout_columnWeight="3"
                android:background="@color/white"
                android:text="" />

            <TextView
                android:id="@+id/surnameLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_column="0"
                android:layout_row="1"
                android:layout_columnWeight="2"
                android:layout_marginTop="10dp"
                android:labelFor="@id/surnameInput"
                android:text="@string/nazwisko"/>

            <EditText
                android:id="@+id/surnameInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_row="1"
                android:layout_column="1"
                android:importantForAutofill="no"
                android:ems="0"
                android:inputType="text"
                android:layout_columnWeight="3"
                android:minWidth="0dp"
                android:background="@color/white"
                android:layout_marginTop="10dp"
                android:text="" />

            <TextView
                android:id="@+id/positionLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_column="0"
                android:layout_row="2"
                android:layout_columnWeight="2"
                android:layout_marginTop="10dp"
                android:labelFor="@id/positionInput"
                android:text="@string/stanowisko"/>

            <Spinner
                android:id="@+id/positionInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_row="2"
                android:layout_column="1"
                android:layout_columnWeight="3"
                android:layout_marginTop="10dp"
                android:background="@color/white"
                android:minWidth="0dp"/>
        </GridLayout>

        <TextView
            android:id="@+id/personalDataGroupLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:background="#B0C4DE"
            android:layout_marginStart="20dp"
            android:padding="5dp"
            android:text="@string/dane_pracownika"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/passwordDataGroupBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp">
        <LinearLayout
            android:id="@+id/passwordGenerationLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/white_border"
            android:padding="20dp"
            android:orientation="vertical"
            android:layout_marginTop="15dp"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:id="@+id/passwordLengthLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/passwordLengthLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:labelFor="@id/passwordLengthInput"
                    android:text="@string/ile_znakow"/>

                <EditText
                    android:id="@+id/passwordLengthInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:ems="0"
                    android:inputType="numberDecimal"
                    android:layout_weight="3"
                    android:minWidth="0dp"
                    android:background="@color/white"
                    android:text="" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/passwordLettersSizeCheckbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/male_i_wielkie_litery"
                android:checked="true"/>

            <CheckBox
                android:id="@+id/passwordDigitsCheckbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cyfry"/>

            <CheckBox
                android:id="@+id/passwordSpecialCharsCheckbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/znaki_specjalne"/>

            <Button
                android:id="@+id/generatePasswordButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#4682B4"
                android:layout_gravity="center_horizontal"
                app:cornerRadius="0dp"
                android:text="@string/generuj_haslo"/>
        </LinearLayout>

        <TextView
            android:id="@+id/passwordDataGroupLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:background="#B0C4DE"
            android:layout_marginStart="20dp"
            android:padding="5dp"
            android:text="@string/generowanie_hasla"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <Button
        android:id="@+id/confirmButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="#4682B4"
        android:layout_gravity="center_horizontal"
        app:cornerRadius="0dp"
        android:text="@string/zatwierdz"/>
</LinearLayout>
