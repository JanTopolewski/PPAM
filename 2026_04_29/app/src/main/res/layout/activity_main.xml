        <ImageView
            android:id="@+id/imageView9"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_margin="10dp"
            android:contentDescription="@string/pszczola"
            android:onClick="onImageClick"
            android:adjustViewBounds="true"
            app:srcCompat="@drawable/pszczola" />

        <ImageView
            android:id="@+id/imageView10"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_margin="10dp"
            android:contentDescription="@string/pole"
            android:onClick="onImageClick"
            android:adjustViewBounds="true"
            app:srcCompat="@drawable/pole" />

        <ImageView
            android:id="@+id/imageView11"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_margin="10dp"
            android:contentDescription="@string/motyl"
            android:onClick="onImageClick"
            android:adjustViewBounds="true"
            app:srcCompat="@drawable/motyl" />

        <ImageView
            android:id="@+id/imageView12"
            android:layout_width="wrap_content"
