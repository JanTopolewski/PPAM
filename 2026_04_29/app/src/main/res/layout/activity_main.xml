            android:adjustViewBounds="true"
            app:srcCompat="@drawable/kwiatek" />

        <ImageView
            android:id="@+id/imageView13"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_margin="10dp"
            android:contentDescription="@string/kot"
            android:onClick="onImageClick"
            android:adjustViewBounds="true"
            app:srcCompat="@drawable/kot" />

        <ImageView
            android:id="@+id/imageView14"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_margin="10dp"
            android:contentDescription="@string/jelen"
            android:onClick="onImageClick"
            android:adjustViewBounds="true"
            app:srcCompat="@drawable/jelen" />

        <ImageView
            android:id="@+id/imageView15"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_margin="10dp"
            android:contentDescription="@string/kosciol"
            android:onClick="onImageClick"
            android:adjustViewBounds="true"
            app:srcCompat="@drawable/kosciol" />
    </LinearLayout>
</HorizontalScrollView>