<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF8DC"
    tools:context=".MainActivity">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="10dp"
        android:orientation="vertical"
        android:id="@+id/paddingBlock">
        <View
            android:id="@+id/colorfulRectangle"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginBottom="15dp"
            android:background="@drawable/main_rectangle"/>

        <TextView
            android:id="@+id/seekBarsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/dobierz_kolor_suwakami_i_zapisz_przyciskiem" />

        <LinearLayout
            android:id="@+id/redColorInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/redColorSliderLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/r" />

            <SeekBar
                android:id="@+id/redColorInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:min="0"
                android:max="255"
                android:progress="255"
                android:progressTint="#BBBBBB"
                android:thumbTint="#CCCCCC"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/redColorValueOutput"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="@string/_255" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/greenColorInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/greenColorSliderLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/g" />

            <SeekBar
                android:id="@+id/greenColorInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:min="0"
                android:max="255"
                android:progress="255"
                android:progressTint="#BBBBBB"
                android:thumbTint="#CCCCCC"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/greenColorValueOutput"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="@string/_255" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/blueColorInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/blueColorSliderLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/b" />

            <SeekBar
                android:id="@+id/blueColorInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:min="0"
                android:max="255"
                android:progress="255"
                android:progressTint="#BBBBBB"
                android:thumbTint="#CCCCCC"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/blueColorValueOutput"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="@string/_255" />
        </LinearLayout>

        <Button
            android:id="@+id/button"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:backgroundTint="#CD853F"
            android:textColor="@color/black"
            app:cornerRadius="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="3dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:layout_marginBottom="20dp"
            android:layout_gravity="center_horizontal"
            android:text="@string/pobierz" />

        <TextView
            android:id="@+id/resultBox"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:layout_gravity="center_horizontal"
            android:text="@string/_255_255_255" />
    </LinearLayout>
</LinearLayout>
