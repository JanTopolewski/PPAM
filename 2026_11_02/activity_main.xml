<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <View
        android:id="@+id/colorfulRectangle"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/main_rectangle"/>

    <TextView
        android:id="@+id/seekBarsLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dobierz kolor suwakami i zapisz przyciskiem" />

    <LinearLayout
        android:id="@+id/redColorInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/redColorSliderLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="R" />

        <SeekBar
            android:id="@+id/redColorInput"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:min="0"
            android:max="255"
            android:progress="255"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/redColorValueOutput"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="255" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/greenColorInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/greenColorSliderLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="G" />

        <SeekBar
            android:id="@+id/greenColorInput"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:min="0"
            android:max="255"
            android:progress="255"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/greenColorValueOutput"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="255" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/blueColorInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/blueColorSliderLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="B" />

        <SeekBar
            android:id="@+id/blueColorInput"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:min="0"
            android:max="255"
            android:progress="255"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/blueColorValueOutput"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="255" />
    </LinearLayout>

    <Button
        android:id="@+id/button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Button" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TextView" />


</LinearLayout>